      <property name="styleSheet">
       <string notr="true">QGroupBox {
    background-color: rgb(171, 186, 255);
    border: 2px solid red; /* Red border */
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    color: white;
    padding: 10px;
    margin-top: 15px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 5px 15px;
    background-color: red; /* Red title background */
    color: white;
    border-radius: 5px;
}
</string>
