    font-weight: bold;
    color: white;
    padding: 10px;
    margin-top: 15px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 5px 15px;
    background-color: rgb(229, 28, 255); /* Red title background */
    color: white;
    border-radius: 5px;
}
