      </property>
      <property name="styleSheet">
       <string notr="true">QTableView {
    background-color: #4A2B7F; /* Lighter dark purple background */
    color: white; /* White text */
    gridline-color: #6B3F98; /* Lighter purple gridlines */
}

QTableView::item {
    padding: 5px;
    background-color: #5A3F99; /* Lighter purple for rows */
    border: 1px solid #6B3F98; /* Border around each cell */
}

QTableView::item:selected {
    background-color: #7A4DA9; /* Lighter purple when selected */
    color: white;
}

QTableView::horizontalHeader, QTableView::verticalHeader {
    background-color: #5A3F99; /* Lighter purple header */
    color: white; /* White text in header */
    border: none;
}

QTableView::horizontalHeader::section, QTableView::verticalHeader::section {
    padding: 10px;
    border: 1px solid #6B3F98; /* Header section borders */
}

QTableView::horizontalHeader::section:active, QTableView::verticalHeader::section:active {
    background-color: #7A4DA9; /* Highlight active header section */
}
</string>
